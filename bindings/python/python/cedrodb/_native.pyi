from typing import Optional

class CedroError(RuntimeError): ...
class DatabaseClosedError(CedroError): ...

class NativeDatabase:
    def __init__(self, path: str, max_document_bytes: int = ..., max_frame_bytes: int = ..., max_state_bytes: int = ...) -> None: ...
    @property
    def closed(self) -> bool: ...
    def close(self) -> None: ...
    def get_json(self, collection: str, key: str) -> Optional[str]: ...
    def put_json(self, collection: str, key: str, value: str) -> None: ...
    def delete(self, collection: str, key: str) -> None: ...
    def batch_json(self, operations: str) -> None: ...
    def compare_exchange_json(self, collection: str, key: str, expected: Optional[str], replacement: Optional[str]) -> bool: ...
    def query_json(self, collection: str, query: str) -> str: ...
    def create_index(self, collection: str, field: str) -> None: ...
    def aggregate_json(self, collection: str, field: str) -> str: ...
    def changes_json(self, since: int, limit: int) -> str: ...
    def stats_json(self) -> str: ...
    def verify_json(self) -> str: ...
    def backup_json(self, path: str) -> str: ...
    @staticmethod
    def restore_backup_json(backup_path: str, destination_path: str, max_document_bytes: int = ..., max_frame_bytes: int = ..., max_state_bytes: int = ...) -> str: ...
