import cedrodb = require('cedrodb');
import { Database, type Query } from 'cedrodb';
const db: cedrodb.Database = new cedrodb.Database('./unused-typecheck');
const other = new Database('./unused-typecheck-other');
const query: Query = { limit: 2 };
const result: cedrodb.QueryPage = db.collection('c').findPage(query);
const version: '0.7.0' = cedrodb.version;
const verified: cedrodb.IntegrityReport = db.verify();
const restored: cedrodb.IntegrityReport = cedrodb.Database.restoreBackup('./new-backup.cedro', './new-data');
const condition: cedrodb.Condition = { kind: 'equals', collection: 'c', key: 'a', value: null };
const conditional: cedrodb.ConditionalResult = db.conditionalBatch({ conditions: [condition], operations: [] });
const queue: cedrodb.Queue = new cedrodb.Queue(db, 'reports');
const job: cedrodb.Job = queue.enqueue('job:1', null).job;
const leased: cedrodb.LeasedJob | undefined = queue.claim('worker');
if (leased) queue.fail(leased.id, leased.leaseToken, 'temporary', { retryDelayMs: 50 });
const recovered: cedrodb.RecoveryResult = queue.recoverExpired({ limit: 10 });
const searchQuery: cedrodb.SearchQuery = { text: 'cedro', vector: [1, 0] };
const search: cedrodb.SearchPage = db.collection('knowledge').search(searchQuery);
const agents: cedrodb.AgentStore = new cedrodb.AgentStore(db, 'support');
const saved: cedrodb.CheckpointResult = agents.checkpoint('thread', null, { expectedRevision: null });
const diagnostics: cedrodb.Diagnostics = db.diagnostics();
const metrics: cedrodb.OperationMetrics = diagnostics.session.query;
const limits: cedrodb.ContentLimits = diagnostics.limits;
const collectionDiagnostics: cedrodb.CollectionDiagnostics | undefined = diagnostics.collections[0];
const queryProfile: cedrodb.QueryProfile = db.collection('c').profileQuery(query);
const searchProfile: cedrodb.SearchProfile = db.collection('c').profileSearch(searchQuery);
const plan: cedrodb.ProfilePlan = queryProfile.plan;
void [other, result, version, verified, restored, conditional, job, recovered, search, saved, diagnostics, metrics, limits, collectionDiagnostics, queryProfile, searchProfile, plan];
