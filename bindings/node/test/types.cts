import cedrodb = require('cedrodb');
import { Database, type Query } from 'cedrodb';
const db: cedrodb.Database = new cedrodb.Database('./unused-typecheck');
const other = new Database('./unused-typecheck-other');
const query: Query = { limit: 2 };
const result: cedrodb.QueryPage = db.collection('c').findPage(query);
const version: '0.5.0' = cedrodb.version;
const verified: cedrodb.IntegrityReport = db.verify();
const restored: cedrodb.IntegrityReport = cedrodb.Database.restoreBackup('./new-backup.cedro', './new-data');
const condition: cedrodb.Condition = { kind: 'equals', collection: 'c', key: 'a', value: null };
const conditional: cedrodb.ConditionalResult = db.conditionalBatch({ conditions: [condition], operations: [] });
const queue: cedrodb.Queue = new cedrodb.Queue(db, 'reports');
const job: cedrodb.Job = queue.enqueue('job:1', null).job;
const leased: cedrodb.LeasedJob | undefined = queue.claim('worker');
if (leased) queue.fail(leased.id, leased.leaseToken, 'temporary', { retryDelayMs: 50 });
const recovered: cedrodb.RecoveryResult = queue.recoverExpired({ limit: 10 });
void [other, result, version, verified, restored, conditional, job, recovered];
