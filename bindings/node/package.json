{
  "name": "cedrodb",
  "version": "0.7.0",
  "description": "Native Rust storage for agent checkpoints, hybrid memory retrieval and persistent local jobs.",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "index.d.cts",
    "native.cjs",
    "platform.cjs",
    "Cargo.toml",
    "Cargo.lock",
    "build.rs",
    "src",
    "core",
    "scripts",
    "prebuilds",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/vendor-core.mjs && node scripts/build.mjs",
    "install": "node scripts/build.mjs --if-needed",
    "prepack": "node scripts/vendor-core.mjs",
    "test": "node --test test/*.test.cjs",
    "example": "node examples/quickstart.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://www.ltavarez.me/labs/cedrodb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uppy19d0/cedrodb.git",
    "directory": "bindings/node"
  },
  "author": "Luis Tavarez",
  "keywords": [
    "database",
    "embedded",
    "rust",
    "native",
    "documents",
    "offline",
    "job-queue",
    "outbox",
    "backup",
    "changefeed",
    "cedrodb",
    "agent-memory",
    "checkpoints",
    "vector-search",
    "hybrid-search",
    "local-first"
  ]
}
